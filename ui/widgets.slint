import { Button, HorizontalBox, VerticalBox } from "std-widgets.slint";

import { Button, HorizontalBox, VerticalBox } from "std-widgets.slint";

export component AlertDialog {
    in-out property <bool> is_open: false;
    in property <string> title: "";
    in property <string> text: "";

    in property <string> confirm_text: "";
    in property <string> cancel_text: "";
    in property <bool> show_cancel: cancel_text != "";

    callback confirmed();
    callback canceled();

    width: 100%;
    height: 100%;

    property <length> anim_offset: root.is_open ? 0px : 40px;
    animate anim_offset {
        duration: 250ms;
        easing: ease-out;
    }
    x: (root.is_open || self.opacity > 0.01) ? 0px : -9999px;

    opacity: root.is_open ? 1.0 : 0.0;
    animate opacity {
        duration: 200ms;
        easing: ease-out;
    }

    dialog_box := Rectangle {
        width: 360px;
        height: self.preferred-height;
        background: #ffffff;
        border-radius: 12px;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000040;
        y: (parent.height - self.height) / 2 + root.anim_offset;

        VerticalBox {
            padding: 22px;
            spacing: 16px;

            Text {
                text: root.title;
                font-size: 20px;
                font-weight: 700;
                color: black;
            }

            TextInput {
                text: root.text;
                read-only: true;
                single-line: false;
                wrap: word-wrap;
                color: #555555;
            }

            HorizontalBox {
                alignment: end;
                spacing: 12px;
                padding: 0px;

                if root.show_cancel: Button {
                    text: root.cancel_text;
                    clicked => {
                        root.canceled();
                    }
                }

                Button {
                    text: root.confirm_text;
                    primary: true;
                    clicked => {
                        root.confirmed();
                    }
                }
            }
        }
    }
}

export component InfoCard {
    in-out property <string> title;
    in-out property <string> text;
    Rectangle {
        background: #FFFFFF;
        border-radius: 8px;
        VerticalBox {
            Text {
                text: root.title;
                font-size: 16px;
                color: #405F90;
            }

            Text {
                text: root.text;
                font-size: 24px;
                font-weight: 0;
            }
        }
    }
}
